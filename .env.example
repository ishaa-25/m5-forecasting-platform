# Copy this to .env and fill in your values — never commit .env

# Kaggle credentials (needed for make data)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# MLflow remote tracking (optional; defaults to local mlruns/)
# MLFLOW_TRACKING_URI=https://your-mlflow-server

# OpenAI (optional; needed for Task 9 LLM explanation feature)
# OPENAI_API_KEY=sk-...

# Dashboard
STREAMLIT_SERVER_PORT=8501
